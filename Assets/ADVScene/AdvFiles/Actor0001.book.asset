      - .2
      - 
      - "\u30AA\u30B9\u30AB\u30FC<speed=0.5> </speed>\n\u304A\u4E3B\u306F\u738B\u5C02\u5C5E\u306E\u5F8C\u898B\u4EBA\u3067\u3042\u308D\u3046<speed=0.5>
