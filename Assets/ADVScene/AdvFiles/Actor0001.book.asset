      - 
      - Character0
      - 
      - 
      - .2
      - 
      - "\u30AA\u30B9\u30AB\u30FC<speed=0.5> </speed>\n\u304A\u4E3B\u306F\u738B\u5C02\u5C5E\u306E\u5F8C\u898B\u4EBA\u3067\u3042\u308D\u3046<speed=0.5>
        </speed>\n\u306A\u305C\u7686\u306B\u907A\u8A00\u3092\u4F1D\u3048\u306C\u306E\u304B"
      - 
      - 
      - 
      - "Oscar,<speed=0.5> </speed>\nyou're the king\u2019s personal guardian.<speed=0.5>
        </speed>\nWhy haven't you told\neveryone about his will?"
      isEmpty: 0
      isCommentOut: 0
