      - 
      - Character2
      - 
      - 
      - 
      - 
      - "\u307E\u3060\u93AE\u9B42\u306E\u5100\u3092\u7D42\u3048\u305F\u3070\u304B\u308A<speed=0.5>
        </speed>\n\u5E73\u9759\u306B\u623B\u3063\u3066\u304B\u3089\u3067\u9045\u304F\u3042\u308A\u307E\u305B\u3093"
