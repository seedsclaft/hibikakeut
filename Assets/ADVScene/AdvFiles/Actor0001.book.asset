      strings:
      - 
      - Npc_0006
      - 
      - Character0
      - 
      - 
      - .2
      - 
      - "\u82E5\u541B\u69D8\u304C\u738B\u4F4D\u3092\u7D99\u627F\u3057\u3066<speed=0.5>
        </speed>\n\u3069\u3046\u306A\u308B\u3053\u3068\u304B\u3068\u601D\u3044\u307E\u3057\u305F\u304C"
      - 
      - 
      - 
      - 'I was worried about how things<speed=0.5> </speed>

