      - "\u4EF2\u304C\u826F\u597D\u3060\u3063\u305FActor7\u304C\u7A81\u7136\u614B\u5EA6\u3092\u6025\u5909\u3057\u307E\u3057\u305F\n\u85AC\u5264\u3092\u308F\u3056\u3068\u58CA\u3057\u305F\u308A\u6750\u6599\u3092\u7C97\u60AA\u306A\u3082\u306E\u306B\u5909\u3048\u3089\u308C\u305F\u308A\u3044\u3058\u3081\u3092\u3046\u3051\u308B\u3088\u3046\u306B\u306A\u3063\u305F\u306E\u3067\u3059\n\u3042\u308B\u6642Acto\uFF527\u3068\u4E8C\u4EBA\u306B\u306A\u3063\u305F\u3068\u304DActor5\u306F\u7406\u7531\u3092\u554F\u3044\u305F\u3060\u3057\u307E\u3057\u305F\nActor7\u306F\u85AC\u5264\u304C\u6226\u610F\u3092\u9AD8\u63DA\u3059\u308B\u4E2D\u6BD2\u7269\u3067\u3042\u308B\u3053\u3068\u3092\u544A\u3052\u307E\u3059\nActor5\u306F\u7D76\u671B\u3057\u3066\u3044\u308B\u3068Actor7\u306F\u4E0D\u6575\u306A\u7B11\u307F\u3092\u6D6E\u304B\u3079\u307E\u3059\nActor7\u306F\u5931\u671B\u3057\u3066\u6D99\u3059\u308BActor5\u306B\u6109\u60A6\u3092\u611F\u3058\u3066\u3044\u307E\u3057\u305F\nActor5\u306F\u9003\u3052\u3088\u3046\u3068\u3057\u307E\u3059\u304CActor7\u306F\u7CBE\u795E\u7684\u306B\u8FFD\u3044\u3064\u3081\u3066\u3044\u304D\u307E\u3059\n\u8010\u3048\u3089\u308C\u306A\u304F\u306A\u3063\u305FActor5\u306F\u4EBA\u77E5\u308C\u305A\u6D77\u306B\u8EAB\u3092\u6295\u3058\u3066\u3057\u307E\u3046\u306E\u3067\u3057\u305F"
